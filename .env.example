# ==========================================
# Project Identification
# ==========================================
PROJECT_NAME=beauty_product

# ==========================================
# Port Configuration (Prescribed for Production Host)
# Strictly binds to 127.0.0.1 on host to avoid port collisions
# ==========================================
FRONTEND_PORT=3002
BACKEND_PORT=8092
FRONTEND_ORIGIN=http://localhost:3002

# ==========================================
# Database Configuration (Internal Docker Network)
# NOTE: MySQL port 3306 is internal ONLY and never bound to host.
# ==========================================
DB_HOST=db
DB_PORT=3306
DB_DATABASE=beauty_product_db
DB_USERNAME=app_user
DB_PASSWORD=secret_password
DB_ROOT_PASSWORD=rootsecret

# Prisma Database Connection String
DATABASE_URL="mysql://app_user:secret_password@db:3306/beauty_product_db"

# ==========================================
# Backend Auth & Security (REQUIRED)
# Server requires ADMIN_USERNAME and either ADMIN_PASSWORD or ADMIN_PASSWORD_HASH
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# ADMIN_PASSWORD_HASH=
JWT_SECRET=supersecretjwtkey_change_in_production

# ==========================================
# Cloudinary (Persistent Product & Receipt Image Uploads)
# Get free credentials at https://cloudinary.com/users/register/free
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# SMTP / Mail Configuration (Order Notifications)
# ==========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Jammaila Skin"
